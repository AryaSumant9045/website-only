# Copy to .env.local and fill in. Never commit the real file.
# --- server ---
PORT=8787
HOST=127.0.0.1
# Set a password before exposing this on a public URL.
APP_USER=leadscout
APP_PASSWORD=

# --- keys (all optional; the app runs without them) ---
GOOGLE_PLACES_KEY=
SERPER_KEY=
TAVILY_KEY=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- behaviour ---
# 6 hours. Set 0 to disable the response cache.
CACHE_TTL_MS=21600000
